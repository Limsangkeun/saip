# 서버의 ~/saip/.env 로 복사하고 chmod 600. 실제 값은 저장소에 올리지 않는다.
# 비밀값 만들기: openssl rand -base64 32

# 도메인 연결 전에는 :80, 로컬 리허설은 localhost
DOMAIN=blog.example.com
# ghcr 이미지 주인(소문자)
GITHUB_USER=limsangkeun
# 배포한 이미지 태그(GitHub Actions가 커밋 SHA로 바꾼다)
APP_TAG=latest

POSTGRES_PASSWORD=
BLOG_API_TOKEN=
BLOG_ADMIN_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 매일 백업을 올릴 S3 버킷(Task 7)
BACKUP_BUCKET=
